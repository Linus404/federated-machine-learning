FML_ENVIRONMENT=staging
FML_IMAGE=registry.example/federated-machine-learning@sha256:replace-with-staging-digest
FML_RELEASE=replace-with-staging-git-commit
FML_CONTROL_BIND=127.0.0.1:29093
FML_DASHBOARD_BIND=127.0.0.1:28501
FML_DASHBOARD_HTPASSWD_FILE=/absolute/path/to/dashboard.htpasswd
FML_PREPARED_ARTIFACT_ROOT=/absolute/path/to/artifacts/.prepared-current
FML_LOG_MAX_SIZE=20m
FML_LOG_MAX_FILES=10
